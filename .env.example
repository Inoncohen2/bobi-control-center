# ---------------------------------------------------------------------------
# Bobi Control Center — example environment file
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. NEVER commit real tokens, phone numbers or secrets.
# ---------------------------------------------------------------------------

# --- Adapter selection -----------------------------------------------------
# "mock" (default, Phase 1) or "real" (Phase 2, not implemented yet).
# While this is "mock" the application CANNOT touch a real Home Assistant.
BOBI_ADAPTER=mock

# --- Server ----------------------------------------------------------------
BOBI_HOST=0.0.0.0
BOBI_PORT=8000
BOBI_LOG_LEVEL=info

# Comma-separated origins allowed to call the API during development.
BOBI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Home Assistant (PHASE 2 ONLY — leave empty in Phase 1) ----------------
# These are read server-side only and are never exposed to the browser.
#
# When running as a Home Assistant Add-on, the Supervisor injects
# SUPERVISOR_TOKEN automatically and BOBI_HA_URL defaults to
# http://supervisor/core — you do not need to set either by hand.
BOBI_HA_URL=
BOBI_HA_TOKEN=
BOBI_HA_VERIFY_SSL=true

# --- Persistence -----------------------------------------------------------
# Directory for persistent configuration. Inside the add-on this is /data.
BOBI_DATA_DIR=./data
