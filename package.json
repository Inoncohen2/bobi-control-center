{
  "name": "bobi-control-center",
  "private": true,
  "version": "3.17.0",
  "description": "מרכז הניהול של בובי — Home Assistant App",
  "license": "MIT",
  "scripts": {
    "setup": "npm --prefix bobi_control_center/frontend install && python3 -m venv .venv && .venv/bin/pip install -r bobi_control_center/backend/requirements-dev.txt",
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:frontend": "npm --prefix bobi_control_center/frontend run dev",
    "dev:backend": "cd bobi_control_center/backend && ../../.venv/bin/python -m uvicorn app.main:app --reload --port 8099",
    "build": "npm --prefix bobi_control_center/frontend run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "npm --prefix bobi_control_center/frontend run test",
    "test:backend": "cd bobi_control_center/backend && ../../.venv/bin/python -m pytest -q",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:frontend": "npm --prefix bobi_control_center/frontend run lint",
    "lint:backend": ".venv/bin/ruff check bobi_control_center/backend/",
    "typecheck": "npm --prefix bobi_control_center/frontend run typecheck",
    "check": "npm run lint && npm run typecheck && npm run test",
    "docker:build": "docker build -t bobi-control-center:latest bobi_control_center/",
    "docker:run": "docker run --rm -p 8099:8099 bobi-control-center:latest"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
